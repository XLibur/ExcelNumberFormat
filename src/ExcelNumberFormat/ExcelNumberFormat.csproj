<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <AssemblyName>Xlibur.ExcelNumberFormat</AssemblyName>
    <RootNamespace>Xlibur.ExcelNumberFormat</RootNamespace>
    <PackageId>Xlibur.ExcelNumberFormat</PackageId>
    <!-- MinVer derives the version from git tags, e.g. v1.2.0 -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>.NET library to parse ECMA-376 number format strings and format values like Excel and other spreadsheet softwares.</Description>
    <Authors>ExcelNumberFormat developers</Authors>
    <PackageTags>excel,formatting,numfmt,formatcode</PackageTags>
    <PackageProjectUrl>https://github.com/XLibur/ExcelNumberFormat</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <AssemblyOriginatorKeyFile>ExcelNumberFormat.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign Condition=" '$(OS)' != 'Windows_NT' ">true</PublicSign>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>